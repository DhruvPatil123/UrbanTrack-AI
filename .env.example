# URBANTRACK AI — Environment Configuration Example

# Backend & Server Settings
APP_NAME=URBANTRACK AI
API_V1_STR=/api/v1
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security & Authentication
SECRET_KEY=change-this-in-production-urbantrack-auth-token-key-2026
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Connections
DATABASE_URL=postgresql://urbantrack:urbantrack_secret@localhost:5432/urbantrack_db
REDIS_URL=redis://localhost:6379/0

# Graph & Vector Engines
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=urbantrack_secret
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Storage & Streaming
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# AI / ML Runtime Settings
AI_DEVICE=cpu
DETECTION_CONFIDENCE=0.35
DETECTION_IOU=0.45
REID_SIMILARITY_THRESHOLD=0.72
GNN_MATCH_THRESHOLD=0.65
DEMO_MODE=true
